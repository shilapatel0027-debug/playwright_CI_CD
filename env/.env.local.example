# Local secrets — git-ignored. Copy this file to one of:
#   env/.env.local        → used by every env
#   env/.env.<env>.local  → used only by that env (wins over env/.env.local)
#                           e.g. env/.env.qa.local, env/.env.staging.local
APP_USERNAME=
APP_PASSWORD=
# Optional: a ready-made token. If set, auth setup skips the API login.
API_TOKEN=
